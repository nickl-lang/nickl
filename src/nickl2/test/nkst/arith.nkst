(extern "c" (proc printf [(param (ptr (const) (i8))) ("...")] (i32)))

(call printf ["%zi\n" (add 4 5)])
(call printf ["%zi\n" (sub 4 5)])
(call printf ["%zi\n" (mul 4 5)])
(call printf ["%zi\n" (div 4 5)])
(call printf ["%zi\n" (mod 4 5)])

(call printf ["\n"])

(call printf ["%.16g\n" (add 1.2 3.4)])
(call printf ["%.16g\n" (sub 1.2 3.4)])
(call printf ["%.16g\n" (mul 1.2 3.4)])
(call printf ["%.16g\n" (div 1.2 3.4)])
(call printf ["%.16g\n" (mod 1.2 3.4)])

(call printf ["\n"])

(call printf ["%zi\n" (lsh    1   10)])
(call printf ["%zi\n" (rsh    256 2 )])
(call printf ["%zi\n" (xor    3   2 )])
(call printf ["%zi\n" (bitor  1   2 )])
(call printf ["%zi\n" (bitand 3   2 )])

/* @output
9
-1
20
0
4

4.6
-2.2
4.08
0.3529411764705883
1.2

1024
64
1
3
2

@endoutput */
