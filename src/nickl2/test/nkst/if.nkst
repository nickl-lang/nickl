(extern "c" (proc printf [(param (ptr (const) (i8))) ("...")] (i32)))

(if (true) [
    (call printf ["YES\n"])
])

(if (false) [
    (call printf ["NO\n"])
])

(if (false) [
    (call printf ["NO\n"])
] [
    (call printf ["YES\n"])
])

(if (true) [
    (call printf ["YES\n"])
] [
    (call printf ["NO\n"])
])

/* @output
YES
YES
YES

@endoutput */
