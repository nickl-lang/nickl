extern "c" proc printf(:ptr, ...) :i32

type Mat2 :{[4]f64}

proc getIdentityMatrix() :Mat2 %mat_addr {
    offset :Mat2 %mat_addr, 0 -> %m00_addr
    store 1.0 -> %m00_addr
    offset :Mat2 %mat_addr, 1 -> %m01_addr
    store 0.0 -> %m01_addr
    offset :Mat2 %mat_addr, 2 -> %m10_addr
    store 0.0 -> %m10_addr
    offset :Mat2 %mat_addr, 3 -> %m11_addr
    store 1.0 -> %m11_addr
    ret
}

pub proc _entry() {
    alloc :Mat2 -> %mat_addr
    call getIdentityMatrix, () -> :Mat2 %mat_addr
    offset :Mat2 %mat_addr, 0 -> %m00_addr
    load %m00_addr -> :f64 %m00
    offset :Mat2 %mat_addr, 1 -> %m01_addr
    load %m01_addr -> :f64 %m01
    offset :Mat2 %mat_addr, 2 -> %m10_addr
    load %m10_addr -> :f64 %m10
    offset :Mat2 %mat_addr, 3 -> %m11_addr
    load %m11_addr -> :f64 %m11
    call printf, ("Identity = [[%g, %g], [%g, %g]]\n", ..., \
        :f64 %m00, :f64 %m01, :f64 %m10, :f64 %m11) -> :i32
    ret
}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

