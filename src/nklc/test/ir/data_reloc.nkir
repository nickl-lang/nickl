extern "c" proc printf(:ptr, ...) :i32

type String :{ ptr, u64 }

local const str_data :{ [14]i8 } {"Hello, World!\0"}
local const str :String {str_data, 13}

pub proc _entry() {
    offset :String str, :i32 0 -> %data_ptr
    load %data_ptr -> :ptr %data

    offset :String str, :i32 1 -> %size_ptr
    load %size_ptr -> :u64 %size_64
    cast :u64 %size_64 -> :i32 %size_32

    call printf, ("%.*s\n", ..., :i32 %size_32, :ptr %data) -> :i32

    ret
}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

/* @output
Hello, World!

@endoutput */
