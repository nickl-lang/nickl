extern "c" proc printf(:ptr, ...) :i32

pub proc _entry() {

@start
    jmp @loop_head

@loop_head
    phi (@start :u64 0, @loop_body %i_next) -> %i
    cmp lt :u64 %i, 5 -> %cond
    jmpz :i8 %cond, @endloop

@loop_body
    call printf, ("%zi\n", ..., :u64 %i) -> :i32
    add :u64 %i, 1 -> %i_next
    jmp @loop_head

@endloop
    ret

}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

