extern "c" proc printf(:ptr, ...) :i32
extern "m" proc sqrt(:f64) :f64

type Vec2 :{[2]f64}

local proc Vec2_length(:Vec2 %vec) :f64 {
    offset :Vec2 %vec, :i32 0 -> %x_addr
    load %x_addr -> :f64 %x
    offset :Vec2 %vec, :i32 1 -> %y_addr
    load %y_addr -> :f64 %y
    mul :f64 %x, %x -> %x2
    mul :f64 %y, %y -> %y2
    add :f64 %x2, %y2 -> %len2
    call sqrt, (:f64 %len2) -> :f64 %len
    ret %len
}

pub proc _entry() {
    alloc :Vec2 -> %vec
    offset :Vec2 %vec, :i32 0 -> %x_addr
    store 1.2 -> %x_addr
    offset :Vec2 %vec, :i32 1 -> %y_addr
    store 3.4 -> %y_addr
    call Vec2_length, (:Vec2 %vec) -> :f64 %len
    call printf, ("%lf\n", ..., :f64 %len) -> :i32
    ret
}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

