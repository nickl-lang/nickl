include "vec2.nkir"

extern "c" proc printf(:ptr, ...) :i32

pub proc _entry() {
    alloc :Vec2 -> %vec

    call make_vec2, (11., 12.) -> :Vec2 %vec

    offset :Vec2 %vec, 0 -> %x_addr
    load %x_addr -> :f64 %x
    offset :Vec2 %vec, 1 -> %y_addr
    load %y_addr -> :f64 %y
    call printf, ("vec=[%g, %g]\n", ..., :f64 %x, :f64 %y) -> :i32

    ret
}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

/* @output
vec=[11, 12]

@endoutput */
