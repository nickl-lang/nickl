extern "c" proc puts(:ptr) :i32

extern "pthread" proc pthread_create(:ptr, :ptr, :ptr, :ptr) :i32
extern "pthread" proc pthread_join(:ptr, :ptr) :i32

proc threadProc(:ptr %arg) :ptr {
    call puts, ("hello") -> :i32
    ret 0
}

pub proc _entry() {
    alloc :ptr -> %thread_addr
    call pthread_create, (:ptr %thread_addr, 0, threadProc, 0) -> :i32

    load %thread_addr -> :ptr %thread
    call pthread_join, (:ptr %thread, 0) -> :i32

    ret
}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

/* @output
hello

@endoutput */
