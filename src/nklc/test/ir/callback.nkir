extern "c" proc puts(:i64) :i32

local proc invoke(:ptr %cb) {
    call %cb, ()
    ret
}

local proc callback() {
    call puts, ("Callback has been called!") -> :i32
    ret
}

pub proc _entry() {
    call invoke, (callback)
    ret
}

pub proc main(:i32 %argc, :ptr %argv) :i32 {
    call _entry, ()
    ret 0
}

/* @output
Callback has been called!

@endoutput */
